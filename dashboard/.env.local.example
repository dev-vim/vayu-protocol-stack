# URL of the running Ponder indexer (GraphQL served at PONDER_URL/graphql)
# Matches the port set in indexer/ponder.config.ts
PONDER_URL=http://localhost:42069

# Set to "true" to render the dashboard with static fixture data (no indexer needed).
# Useful for UI development. Remove or set to "false" before connecting to a live indexer.
# MOCK_DATA=true
