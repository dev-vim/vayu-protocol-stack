# Local dev overrides — copy to .env.local and source before running:
#   cp relay/.env.local.example relay/.env.local
#   source relay/.env.local && mvn spring-boot:run
#
# By default this configures Mode A (log-only) — no chain required.
# Uncomment the on-chain commit block below for Mode B (Anvil + deployed contracts required).

# ─── Fast dev cycling ─────────────────────────────────────────────────────────
export RELAY_LOG_LEVEL=DEBUG
export RELAY_EPOCH_DURATION_SECONDS=60
export RELAY_EPOCH_COMMIT_CHECK_INTERVAL_MS=5000
export RELAY_VALIDATION_RATE_LIMIT_WINDOW_SECONDS=30

# ─── IPFS — Kubo defaults work for local dev ──────────────────────────────────
# export RELAY_IPFS_PROVIDER=kubo
# export RELAY_IPFS_KUBO_API_URL=http://localhost:5001

# ─── On-chain commit — Anvil (Mode B) ─────────────────────────────────────────
# Uncomment and fill in values once Anvil is running and contracts are deployed.
# See contracts/README.md for deploy instructions.
# export RELAY_CHAIN_ON_CHAIN_COMMIT_ENABLED=true
# export RELAY_CHAIN_RPC_URL=http://127.0.0.1:8545
# export RELAY_CHAIN_CHAIN_ID=31337
# export RELAY_CHAIN_RELAY_PRIVATE_KEY=<key>            # hex, no 0x prefix
# export RELAY_CHAIN_SETTLEMENT_ADDRESS=<0x...>         # VayuEpochSettlement address

# ─── EIP-712 signature verification (disabled by default in dev) ───────────────
# export RELAY_SECURITY_SIGNATURE_VERIFICATION_ENABLED=true
# export RELAY_SECURITY_EIP712_CHAIN_ID=31337
# export RELAY_SECURITY_EIP712_VERIFYING_CONTRACT=<SETTLEMENT_ADDRESS>