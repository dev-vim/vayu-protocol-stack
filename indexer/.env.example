# Copy this file to .env.local and fill in the values for your environment.
#   cp .env.example .env.local

# ─── Chain selection ──────────────────────────────────────────────────────────
# Which configured chain to index.
# Options: anvil (default) | baseSepolia | base
PONDER_CHAIN=anvil

# ─── RPC endpoints ────────────────────────────────────────────────────────────
# Ponder picks up PONDER_RPC_URL_{chainId} for the active chain.

# Local Anvil (chain ID 31337)
PONDER_RPC_URL_31337=http://localhost:8545

# Base Sepolia testnet (chain ID 84532) — required when PONDER_CHAIN=baseSepolia
PONDER_RPC_URL_84532=

# Base mainnet (chain ID 8453) — required when PONDER_CHAIN=base
PONDER_RPC_URL_8453=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vayu_indexer

# ─── Contract ─────────────────────────────────────────────────────────────────
# VayuEpochSettlement address — copy from forge script deploy output.
# For a fresh Anvil run with the default deployer key the deterministic address is:
#   0x9fE46736679d2D9a65F0992F2272dE9f3c7fa6e0
VAYU_SETTLEMENT_ADDRESS=

# First block to index (skip pre-deployment history).
# Set to 1 for a fresh Anvil node; set to the deployment block for testnet/mainnet.
VAYU_SETTLEMENT_START_BLOCK=1

# ─── IPFS sidecar ─────────────────────────────────────────────────────────────
# HTTP gateway URL used to fetch epoch blobs by CID.
# Local Kubo maps guest port 8080 → host port 8081 to avoid collision with the relay.
IPFS_GATEWAY_URL=http://localhost:8081/ipfs

# How often the sidecar polls for PENDING epochs (milliseconds).
SIDECAR_POLL_INTERVAL_MS=30000

# Max epochs processed per poll cycle.
SIDECAR_BATCH_SIZE=10

# ─── Server ───────────────────────────────────────────────────────────────────
PONDER_PORT=42069
